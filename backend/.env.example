# Supabase Configuration (Backend uses service role key for authoritative writes)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-xxxxxxxxxxxxxxxx

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Notes:
# - SUPABASE_SERVICE_ROLE_KEY should never be exposed to the client.
# - Keep .env out of version control; use this .env.example as a template.
# - For development, the venv is located at the repository root: ../.venv
